{
  "name": "elfalla",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "capturas": "node scripts/capturas.mjs",
    "prueba:panel": "node scripts/prueba-panel.mjs",
    "emuladores": "firebase emulators:start --only firestore,auth --project demo-elfalla",
    "test:firestore": "firebase emulators:exec --only firestore --project demo-elfalla \"FIREBASE_PROJECT_ID=demo-elfalla vitest run tests/firestore.test.ts\"",
    "dev:simulador": "firebase emulators:exec --only firestore,auth --project demo-elfalla \"FIREBASE_PROJECT_ID=demo-elfalla next dev\""
  },
  "dependencies": {
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0",
    "next": "15.5.27",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "firebase-tools": "15.33.0",
    "playwright-core": "1.56.1",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.29"
    },
    "@grpc/grpc-js": "1.14.5"
  }
}
