rules_version = '2';

// El Falla: el navegador NUNCA lee ni escribe directamente en la base de datos.
// Todo pasa por el servidor de la web (Firebase Admin SDK), que no está sujeto a estas reglas
// y comprueba cada voto, cada cuenta y cada acción del panel.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
