# ─── Firebase (servidor) ──────────────────────────────────────────────────────
# Publicado (Vercel): clave de servicio de Firebase, el JSON completo o en base64.
# ES SECRETA: se pega solo en las variables de entorno de Vercel. Nunca en GitHub ni en el chat.
FIREBASE_SERVICE_ACCOUNT=
# Desarrollo: usar el simulador local en lugar del proyecto real (lo pone solo `npm run dev:simulador`).
FIRESTORE_EMULATOR_HOST=
FIREBASE_PROJECT_ID=
# Opcional: cargar las agrupaciones inventadas de prueba en un proyecto real (1 = sí). En el simulador se cargan solas.
ELFALLA_DATOS_PRUEBA=

# ─── Panel de administración ──────────────────────────────────────────────────
# Contraseña provisional del panel (/admin). Se sustituirá por cuentas con rol de administrador.
ADMIN_PASSWORD=
# Opcional: clave para firmar la sesión del panel. Si no se pone, se usa la contraseña.
ADMIN_SECRET=

# ─── Web ──────────────────────────────────────────────────────────────────────
# Dirección pública de la web (para las vistas previas al compartir), por ejemplo https://elfalla.es
NEXT_PUBLIC_SITE_URL=
