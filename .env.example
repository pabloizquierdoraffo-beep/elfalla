# Contraseña del panel de administración (obligatoria para entrar en /admin).
ADMIN_PASSWORD=
# Opcional: clave para firmar la sesión del panel. Si no se pone, se usa la contraseña.
ADMIN_SECRET=
# Opcional: dónde se guarda el archivo de datos provisional (por defecto .data/elfalla.json).
ELFALLA_DATA_FILE=
# Dirección pública de la web (para las vistas previas al compartir), por ejemplo https://elfalla.es
NEXT_PUBLIC_SITE_URL=
